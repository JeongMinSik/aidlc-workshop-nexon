{
  "name": "table-order",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm -w packages/customer run dev",
    "dev:admin": "npm -w packages/admin run dev",
    "build:customer": "npm -w packages/customer run build",
    "build:admin": "npm -w packages/admin run build",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
